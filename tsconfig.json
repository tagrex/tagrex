{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "$lib": ["./app/ui/lib"], "$lib/*": ["./app/ui/lib/*"] }
  },
  "include": [
    "app/ui/components/**/*.svelte",
    "app/ui/components/**/*.ts",
    "app/ui/lib/**/*.svelte",
    "app/ui/lib/**/*.ts"
  ]
}
