{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TagRex Next",
  "version": "1.5.0",
  "identifier": "com.tagrex.next",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TagRex Next",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 360,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 17, "y": 26 }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "category": "Music",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/tagrex.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/tagrex.desktop"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [],
        "name": "Music folder",
        "contentTypes": ["public.folder"],
        "mimeType": "inode/directory",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": [
          "mp3", "flac", "ogg", "oga", "m4a", "m4b", "mp4", "aac", "aif",
          "aiff", "aifc", "wav", "opus", "spx", "mpc", "mp+", "mpp", "ape", "wv"
        ],
        "name": "Audio file",
        "description": "Audio file",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyRjdEN0FDRjdBNERCMjQKUldRazI2VDNyTmYzOHNOQ1o3YW5NS1RMcU5rRXJPc0Q3dVZudkQrSW1ZdFJLc2VvUTE4UjdEMDUK",
      "endpoints": ["https://github.com/tagrex/tagrex/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
