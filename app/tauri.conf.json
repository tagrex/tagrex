{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TagRex",
  "version": "0.15.0",
  "identifier": "com.tagrex.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TagRex",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [],
        "name": "Music folder",
        "contentTypes": ["public.folder"],
        "mimeType": "inode/directory",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": [
          "mp3", "flac", "ogg", "oga", "m4a", "m4b", "mp4", "aac", "aif",
          "aiff", "aifc", "wav", "opus", "spx", "mpc", "mp+", "mpp", "ape", "wv"
        ],
        "name": "Audio file",
        "description": "Audio file",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  }
}
